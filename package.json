{
  "name": "squadpitch-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import ./instrument.js server.js",
    "dev": "NODE_ENV=development node --import ./instrument.js --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:launch": "node scripts/launch-tests/index.js",
    "test:launch:json": "node scripts/launch-tests/index.js --json",
    "canary:production": "node scripts/production-canary/index.js",
    "canary:production:json": "node scripts/production-canary/index.js --json",
    "verify:beta-gate": "node scripts/beta-launch-gate/index.js",
    "verify:beta-gate:json": "node scripts/beta-launch-gate/index.js --json",
    "test:ai-provenance": "vitest run tests/aiExecutionProvenance.test.js tests/aiProductionVerification.test.js",
    "verify:ai-production": "node scripts/ai-production-verification/index.js",
    "verify:ai-production:json": "node scripts/ai-production-verification/index.js --json",
    "verify:ai-production:strict": "node scripts/ai-production-verification/index.js --strict",
    "verify:production": "node scripts/production-readiness/index.js",
    "verify:production:json": "node scripts/production-readiness/index.js --json",
    "verify:production:no-network": "node scripts/production-readiness/index.js --no-network",
    "verify:backup-recovery": "node scripts/backup-recovery/validate.js",
    "verify:backup-recovery:json": "node scripts/backup-recovery/validate.js --json",
    "verify:observability": "node scripts/observability/validate.js",
    "verify:sentry": "node scripts/verify-sentry.js",
    "verify:worker-health": "node scripts/worker-health/index.js",
    "verify:worker-health:json": "node scripts/worker-health/index.js --json",
    "verify:worker-roundtrip": "node scripts/worker-health/index.js",
    "verify:worker-alert": "node scripts/verify-worker-alert.js",
    "stripe:migration:inspect": "node scripts/stripe-migration/inspect.js",
    "stripe:migration:inspect:json": "node scripts/stripe-migration/inspect.js --json",
    "stripe:migration:reset": "node scripts/stripe-migration/reset.js",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:backfill-campaigns": "node scripts/backfillCampaigns.js",
    "db:backfill-campaigns:dry": "node scripts/backfillCampaigns.js --dry-run",
    "db:seed-flags": "node scripts/seedFlags.js",
    "db:seed-test-site": "node scripts/seedTestSite.js"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.67.0",
    "archiver": "^8.0.0",
    "bullmq": "^5.73.0",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.7.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "postmark": "^4.0.7",
    "replicate": "^1.4.0",
    "sharp": "^0.35.3",
    "stripe": "^22.0.1",
    "twilio": "^5.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
