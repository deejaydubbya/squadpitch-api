{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squadpitch.com/contracts/ai-platform/v1/service-envelope.schema.json",
  "title": "Squadpitch AI Service Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "workspaceId",
    "actorUserId",
    "scopes",
    "issuedAt",
    "expiresAt",
    "nonce",
    "payload",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-service-envelope.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "actorUserId": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "health:read",
          "eval:run",
          "retrieval:query",
          "campaign-plan:read",
          "autopilot-rank:read",
          "content-score:read"
        ]
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
