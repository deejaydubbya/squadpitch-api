# =============================================================================
# Squadpitch API — environment variables
#
# Required vs optional:
#   [REQUIRED]   the API will fail to function meaningfully without it
#   [BETA]       required to ship the beta product
#   [OPTIONAL]   feature degrades gracefully when unset (boot warning)
#
# Fail-fast production validation lives in config/productionConfig.js;
# optional availability warnings live in config/env.js. Run
# `node --import ./instrument.js server.js` and read the [BOOT] log
# lines after start to see what's missing.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080                                              # [OPTIONAL] default 8080
NODE_ENV=development                                   # [OPTIONAL] production|development
ALLOWED_ORIGINS=http://localhost:3000                  # [REQUIRED] CORS allow-list (comma-separated)
APP_URL=https://app.squadpitch.com                     # [REQUIRED] used in notification deep-links

# ── Auth0 (REQUIRED) ─────────────────────────────────────────────────────────
AUTH0_DOMAIN=auth.squadpitch.com                       # [REQUIRED]
AUTH0_AUDIENCE=https://api.squadpitch.com              # [REQUIRED] must match the Auth0 API identifier

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/squadpitch

# ── Redis (REQUIRED in production — BullMQ workers + dedup + rate limits) ────
REDIS_URL=redis://localhost:6379                       # [BETA]

# ── Workers ──────────────────────────────────────────────────────────────────
ENABLE_WORKERS=true                                    # [BETA] runs scheduled-publish + media gen workers in-process

# ── OAuth crypto (REQUIRED to connect any social channel) ────────────────────
OAUTH_STATE_SECRET=                                    # [BETA] random 32+ bytes
TOKEN_ENCRYPTION_KEY=                                  # [BETA] base64 32 bytes for AES-256-GCM

# ── Cloudinary (REQUIRED — media storage) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=                                 # [BETA]
CLOUDINARY_API_KEY=                                    # [BETA]
CLOUDINARY_API_SECRET=                                 # [BETA]

# ── OpenAI (REQUIRED — text generation) ──────────────────────────────────────
OPENAI_API_KEY=                                        # [BETA]
OPENAI_DEFAULT_MODEL=gpt-4o-mini                       # [OPTIONAL]
OPENAI_MONTHLY_BUDGET_CENTS=2000                       # [OPTIONAL] global cap

# ── Fal.ai (REQUIRED — image/video generation) ───────────────────────────────
FAL_API_KEY=                                           # [BETA]
FAL_DEFAULT_MODEL=fal-ai/flux/dev                      # [OPTIONAL]
FAL_MONTHLY_BUDGET_CENTS=1000                          # [OPTIONAL] global cap

BUDGET_WARNING_THRESHOLD=0.8                           # [OPTIONAL] 0..1, alert at this % of monthly cap

# ── Replicate (OPTIONAL — SAM 2 listing-image segmentation) ──────────────────
REPLICATE_API_TOKEN=                                   # [OPTIONAL]
# REPLICATE_SAM2_MODEL=meta/sam-2:fe97b453a6455861e3bac769b441ca1f1086110da7466dbb65cf1eecfd60dc83

# ── Jina Reader (OPTIONAL — URL scraping) ────────────────────────────────────
JINA_API_KEY=                                          # [OPTIONAL]

# ── Channel OAuth credentials (BETA — one per channel you ship) ──────────────
META_APP_ID=                                           # [BETA] Facebook Login (Page scopes)
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
# Instagram Login / Business Login (instagram_business_* scopes,
# including instagram_business_manage_comments for the Inbox
# comments ingestion path). May be a separate Meta App from
# META_APP_ID. Falls back to META_* values when these aren't set so
# existing single-app installs keep working during the migration.
INSTAGRAM_APP_ID=                                      # [BETA] Instagram Business Login
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
# Meta Inbox ingestion (FB Page comments + IG comments) is now
# polling-based — no webhook env vars required. See the inbox
# polling service for the cron interval.
#
# Background scheduler for Facebook + Instagram comment polling.
# Manual sync routes (POST .../sync-comments) ignore this flag and
# always run — these only gate the recurring 15-minute tick.
META_COMMENT_POLLING_ENABLED=false                     # [BETA] cron-tick Meta comment poller
META_COMMENT_POLLING_INTERVAL_MINUTES=15               # [BETA] minutes between scheduled ticks
META_COMMENT_POLLING_LOOKBACK_DAYS=30                  # [BETA] only walk posts newer than this

TIKTOK_CLIENT_KEY=                                     # [BETA]
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

LINKEDIN_CLIENT_ID=                                    # [BETA] Personal Profile app — Sign In + Share products
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://app.squadpitch.com/oauth/LINKEDIN/callback

LINKEDIN_ORG_CLIENT_ID=                                # [OPTIONAL] Organization Page app — Community Management API only
LINKEDIN_ORG_CLIENT_SECRET=
LINKEDIN_ORG_REDIRECT_URI=https://app.squadpitch.com/oauth/LINKEDIN_ORGANIZATION_PAGE/callback
LINKEDIN_ORG_SCOPES=r_organization_admin,w_organization_social,r_organization_social

PINTEREST_CLIENT_ID=                                   # [BETA] Pinterest API v5
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://app.squadpitch.com/oauth/PINTEREST/callback

X_CLIENT_ID=                                           # [BETA]
X_CLIENT_SECRET=
X_REDIRECT_URI=

YOUTUBE_CLIENT_ID=                                     # [BETA]
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Google Business Profile — Inbox reviews channel. Separate OAuth
# client from YouTube (different scope = different consent screen).
# Redirect URI must be EXACTLY: https://app.squadpitch.com/oauth/GOOGLE_BUSINESS_PROFILE/callback
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=                     # [BETA]
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=https://app.squadpitch.com/oauth/GOOGLE_BUSINESS_PROFILE/callback

# Threads (Meta — separate developer app from Facebook/Instagram).
# See docs/THREADS_SETUP.md for callback URLs and Fly secrets commands.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://app.squadpitch.com/oauth/THREADS/callback
THREADS_UNINSTALL_CALLBACK_URL=https://app.squadpitch.com/api/webhooks/meta/threads/deauthorize
THREADS_DELETE_CALLBACK_URL=https://app.squadpitch.com/api/webhooks/meta/threads/data-deletion
THREADS_API_VERSION=v1.0
THREADS_ENABLED=true

GBP_CLIENT_ID=                                         # [OPTIONAL] Google Business Profile
GBP_CLIENT_SECRET=
GBP_REDIRECT_URI=

# ── Cloud import (OPTIONAL) ─────────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=                                # [OPTIONAL]
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

GOOGLE_SHEETS_CLIENT_ID=                               # [OPTIONAL]
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=

DROPBOX_APP_KEY=                                       # [OPTIONAL]
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=

# ── Notifications ────────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=                                 # [BETA] transactional email (used for system notifications AND Inbox outbound)
NOTIFICATION_FROM_EMAIL=notifications@squadpitch.com   # [OPTIONAL] system→user notifications (POST_FAILED, etc.)

# ── Inbox — Postmark outbound + inbound (BETA) ───────────────────────────────
# Powers user→lead email replies from the Inbox composer. Deliberately
# namespaced as INBOX_EMAIL_* (not POSTMARK_*) so the system-notification
# provider (NOTIFICATION_FROM_EMAIL above) and the Inbox outbound path
# can't accidentally reuse each other's from-address or reply domain.
# Postmark server token is shared (one Postmark account); the streams /
# from / reply behaviors are separate.
POSTMARK_MESSAGE_STREAM=outbound                       # [PROD REQUIRED] active Postmark transactional message stream ID
# While the Postmark account is in sandbox the From address must
# share the domain of the only verified sender (e.g.
# "Squadpitch <support@squadpitch.com>") and can only send to
# domain-matched recipients. After Postmark approval, switch to:
#   INBOX_EMAIL_FROM="Squadpitch Inbox <inbox@mail.squadpitch.com>"
# via:  fly secrets set -a squadpitch-api INBOX_EMAIL_FROM='Squadpitch Inbox <inbox@mail.squadpitch.com>'
# Reply-To stays reply+<convId>@<INBOX_EMAIL_REPLY_DOMAIN> in both cases.
INBOX_EMAIL_FROM=                                      # [BETA] e.g. "Squadpitch Inbox <inbox@mail.squadpitch.com>" — From: header on user→lead replies
INBOX_EMAIL_REPLY_DOMAIN=                              # [BETA] inbound parse domain (verified Postmark sender subdomain), e.g. mail.squadpitch.com — routed reply addresses live here
POSTMARK_INBOUND_WEBHOOK_SECRET=                       # [PROD REQUIRED] Basic-auth webhook password, at least 32 random chars; never place it in query params

TWILIO_ACCOUNT_SID=                                    # [OPTIONAL] SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=                          # MG... production Messaging Service with approved sender pool and opt-out configuration
TWILIO_INBOUND_WEBHOOK_URL=https://squadpitch-api.fly.dev/api/v1/inbox/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK_URL=https://squadpitch-api.fly.dev/api/v1/inbox/webhooks/twilio/status
INBOX_SMS_DAILY_CAP=50
INBOX_SMS_MAX_CHARS=480
SMS_A2P_APPROVED=false                                 # Set true only after the applicable Brand + Campaign are approved
SMS_SENDING_ENABLED=false                              # Independent kill switch; both flags must be true to send any SMS

VAPID_PUBLIC_KEY=                                      # [OPTIONAL] web push (generate with `npx web-push generate-vapid-keys`)
VAPID_PRIVATE_KEY=

# ── Property data ────────────────────────────────────────────────────────────
PROPERTY_DATA_PROVIDER=rentcast                        # [OPTIONAL] rentcast|attom
RENTCAST_API_KEY=                                      # [BETA — for real estate beta]
# ATTOM_API_KEY=

# ── Stripe (REQUIRED for billing) ────────────────────────────────────────────
STRIPE_SECRET_KEY=                                     # [BETA] sk_live_... in prod, sk_test_... in dev
STRIPE_EXPECTED_MODE=test                              # [REQUIRED] live in production; test in local development
STRIPE_WEBHOOK_SECRET=                                 # [BETA] whsec_... — get from Stripe webhook endpoint config
STRIPE_STARTER_PRICE_ID=                               # [BETA] price_... — Solo plan
STRIPE_PRO_PRICE_ID=                                   # [BETA] price_... — Pro plan
STRIPE_GROWTH_PRICE_ID=                                # [BETA] price_... — Team plan
STRIPE_AGENCY_PRICE_ID=                                # [OPTIONAL] price_... — assisted Agency migrations only
STRIPE_STARTER_PRODUCT_ID=                             # [BETA] prod_... — Solo product
STRIPE_PRO_PRODUCT_ID=                                 # [BETA] prod_... — Pro product
STRIPE_GROWTH_PRODUCT_ID=                              # [BETA] prod_... — Team product

# ── Admin access ─────────────────────────────────────────────────────────────

# ── Observability (OPTIONAL — graceful degradation) ──────────────────────────
SENTRY_DSN=                                            # [OPTIONAL] @sentry/node v8 DSN
SENTRY_ENVIRONMENT=                                    # [OPTIONAL] defaults to NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=0.05                         # [OPTIONAL] 0..1
SENTRY_RELEASE=                                        # [OPTIONAL] Git SHA; defaults to Fly image metadata
SENTRY_DELIVERY_VERIFIED=                              # [OPTIONAL] date/event reference after dashboard confirmation

# Internal Python AI service authentication. Separate from Auth0 and provider secrets.
AI_PLATFORM_INTERNAL_BASE_URL=http://squadpitch-ai.internal:8080
AI_PLATFORM_HEALTH_TIMEOUT_MS=1500
AI_PLATFORM_SERVICE_AUTH_KEY_ID=primary
AI_PLATFORM_SERVICE_AUTH_SECRET=                       # [BETA] HMAC secret shared only by squadpitch-api and squadpitch-ai
APP_BUILD_SHA=                                         # [OPTIONAL] deployed API commit/build identifier
AI_PROVENANCE_RESPONSE_HEADERS_ENABLED=false           # [OPTIONAL] expose safe AI provenance response headers
AI_RETRIEVAL_ENABLED=false                             # [OPTIONAL] gated RAG path; clientOrchestrator.js remains fallback
AI_CAMPAIGN_OPS_AGENT_ENABLED=false                    # [OPTIONAL] read-only campaign plan proposal preview
AI_ACTION_PROPOSALS_ENABLED=false                      # [OPTIONAL] Node-owned proposal persistence; keep off until eval gates pass
AI_OPERATIONS_CENTER_ENABLED=false                     # [OPTIONAL] admin-only AI observability panels
AI_AUTOPILOT_ML_RANKING_ENABLED=false                  # [OPTIONAL] shadow/default-off ML opportunity ranking
AI_BRAND_QUALITY_MODEL_ENABLED=false                   # [OPTIONAL] shadow/default-off brand content quality scoring
AI_EXPERIMENTATION_ENABLED=false                       # [OPTIONAL] admin-only AI experimentation analysis reports

# Manual deployed AI verification (developer workstation or workflow only).
# Token must be an Auth0 access token with the developer or admin role.
SQUADPITCH_VERIFY_BASE_URL=https://squadpitch-api.fly.dev
SQUADPITCH_VERIFY_TOKEN=

# ── Synthetic production canary (OPTIONAL, explicitly allowlisted) ────────────
PRODUCTION_CANARY_WORKSPACE_ID=                        # dedicated workspace owned by a non-admin synthetic identity
PRODUCTION_CANARY_MEDIA_ENABLED=false                  # opt-in only; default canary never generates paid media
PRODUCTION_CANARY_SITES_HEALTH_URL=https://squadpitch-sites.fly.dev/api/health
SQUADPITCH_VERIFY_COOKIE=                              # [LOCAL ONLY] complete app.squadpitch.com Cookie header; alternative to token
SQUADPITCH_VERIFY_WORKSPACE_ID=
SQUADPITCH_CANARY_BASE_URL=https://app.squadpitch.com
SQUADPITCH_CANARY_WORKSPACE_ID=
SQUADPITCH_CANARY_COOKIE=                             # [LOCAL ONLY] short-lived normal synthetic-user Cookie header
WORKER_ALERT_DELIVERY_VERIFIED=                       # manual Sentry event/email confirmation reference; never inferred from config alone

# ── Publishing reliability ───────────────────────────────────────────────────
PUBLISH_ADAPTER_TIMEOUT_MS=45000                       # [OPTIONAL] hard cap per adapter call
OPS_SLACK_WEBHOOK_URL=                                 # [OPTIONAL] backlog/failure alerts
