generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum ClientStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// LINKEDIN                    = LinkedIn Personal Profile (existing flow,
//                              unchanged). Uses the Sign In + Share
//                              products on the original LinkedIn app.
// LINKEDIN_ORGANIZATION_PAGE  = posts to a Company / Organization Page
//                              the connecting member administers. Uses
//                              a separate LinkedIn developer app with
//                              the Community Management API product.
//                              See docs/LINKEDIN_SETUP.md.
enum Channel {
  INSTAGRAM
  TIKTOK
  X
  LINKEDIN
  LINKEDIN_ORGANIZATION_PAGE
  FACEBOOK
  YOUTUBE
  PINTEREST
  THREADS
  // Google Business Profile — Inbox-only surface (no publishing).
  // Connected via OAuth + business.manage scope (Google sensitive-
  // scope verification required). Reviews ingestion + reply land
  // in a follow-up prompt; for now this exists so the channel
  // appears in Settings → Channels as a "Coming soon" tile.
  GOOGLE_BUSINESS_PROFILE
}

enum MediaMode {
  BRAND_ASSETS_ONLY
  BRAND_ASSETS_PLUS_AI
  AI_CHARACTER
}

enum DraftKind {
  POST
  CAPTION
  VIDEO_SCRIPT
  CAROUSEL
  HOOKS
  CTA_VARIANTS
  REPLY
}

enum DraftStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  FAILED
}

enum ConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
  EXPIRED
  REVOKED
  ERROR
}

enum MediaAssetSource {
  UPLOAD
  AI_GENERATED
  IMPORTED
}

enum MediaAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum DataSourceType {
  MANUAL
  URL
  CSV
  TEXT
  GOOGLE_SHEETS
  NOTION
}

enum DataItemStatus {
  ACTIVE
  ARCHIVED
}

enum DataItemType {
  TESTIMONIAL
  CASE_STUDY
  PRODUCT_LAUNCH
  PROMOTION
  STATISTIC
  MILESTONE
  FAQ
  TEAM_SPOTLIGHT
  INDUSTRY_NEWS
  EVENT
  PROPERTY
  CUSTOM
}

enum BlueprintCategory {
  SOCIAL_PROOF
  EDUCATION
  BEHIND_THE_SCENES
  PROMOTION
  ENGAGEMENT
  STORYTELLING
  AUTHORITY
  SEASONAL
}

enum ConversionEventType {
  LINK_CLICK
  FORM_SUBMISSION
  CALL_BOOKED
  CONTACT_CLICK
  LISTING_INQUIRY
  CRM_LEAD
  CUSTOM
}

enum PersonaType {
  AGENT
  BRAND_STYLE
  TEAM
}

enum PersonaTrainingStatus {
  DRAFT
  UPLOADING
  READY_TO_TRAIN
  QUEUED
  TRAINING
  COMPLETED
  FAILED
}

// ── User ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  auth0Sub  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ── Client ─────────────────────────────────────────────────────────────

model Client {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      ClientStatus @default(ACTIVE)
  logoUrl     String?
  industryKey String?
  timezone    String       @default("UTC")
  // Inbox contact retention window. Documentary only today —
  // there is NO auto-purge worker; manual purge requires an
  // explicit DELETE call. Stored so a future retention worker
  // (and the workspace settings UI) can show the policy without
  // a schema change.
  contactRetentionDays Int?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  brandProfile         BrandProfile?
  voiceProfile         VoiceProfile?
  mediaProfile         MediaProfile?
  brandPersona         BrandPersona?
  contentPreferences   ContentPreferences?
  campaigns            Campaign[]
  site                 Site?
  channelSettings      ChannelSettings[]
  drafts               Draft[]
  moderationLogs       ModerationLog[]
  connections          ChannelConnection[]
  mediaAssets          MediaAsset[]
  assetFolders         AssetFolder[]
  postMetrics          PostMetrics[]
  postMetricSnapshots  PostMetricSnapshot[]
  rawMetrics           RawMetric[]
  normalizedMetrics    NormalizedMetric[]
  postInsights         PostInsight[]
  workspaceAnalytics   WorkspaceAnalytics?
  analyticsSnapshots   AnalyticsSnapshot[]
  dataSources          WorkspaceDataSource[]
  dataItems            WorkspaceDataItem[]
  techStackConnections WorkspaceTechStackConnection[]
  trackableLinks       TrackableLink[]
  conversionEvents     ConversionEvent[]
  contacts             Contact[]
  conversations        Conversation[]
  adPackages           AdPackage[]

  @@index([status])
  @@map("clients")
}

// ── Profiles ───────────────────────────────────────────────────────────

model BrandProfile {
  clientId     String   @id
  description  String?  @db.Text
  industry     String?
  audience     String?  @db.Text
  website      String?
  socialsJson  Json?
  offers       String?  @db.Text
  competitors  String?  @db.Text
  examplePosts Json?
  city         String?
  state        String?
  marketArea   String?
  primaryZip   String?
  serviceAreas Json?
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model VoiceProfile {
  clientId       String   @id
  tone           String?
  voiceRulesJson Json
  bannedPhrases  String[]
  ctaPreferences Json?
  contentBuckets Json
  version        Int      @default(1)
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("voice_profiles")
}

// Persistent per-workspace defaults the assistant reads when the
// user hasn't made an explicit choice in-session yet. Already wired
// into lib/assistant/contentPreferences.ts on the web side; this
// model + the matching /content-preferences route are the backing
// storage. All fields are optional / nullable so that a workspace
// without any saved preferences still resolves to safe defaults.
model ContentPreferences {
  clientId                 String    @id
  preferredChannels        Channel[] @default([])
  defaultQuickPostChannel  Channel?
  preferredTone            String?
  preferredCtaStyle        String?
  preferredCampaignCadence String?
  defaultCampaignType      String?
  mediaOrderPreference     String?
  defaultContentBucket     String?
  alwaysRequireReview      Boolean   @default(true)
  autoGenerateMedia        Boolean   @default(false)
  // Plan 07 — additional assistant defaults.
  // All nullable / array-default so existing rows stay valid
  // without backfill. String-typed enums (not Prisma enums) so
  // adding option values stays a code-only change.
  defaultContentMode       String? // 'campaign' | 'single_post'
  defaultSource            String? // 'property' | 'data_item' | 'idea'
  preferredContentGoals    String[]  @default([]) // 'growth' | 'engagement' | 'sales'
  defaultCtaPreference     String? // 'dm_me' | 'schedule_consult' | 'visit_website' | 'call_now' | 'custom'
  defaultCtaCustom         String?
  defaultCampaignLength    Int? // 3 | 5 | 7
  preferredPostingDays     String[]  @default([]) // 'mon' | 'tue' | ... | 'sun'
  preferredPostingTime     String? // "HH:mm" — interpreted in Client.timezone
  updatedAt                DateTime  @updatedAt
  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("content_preferences")
}

// First-class Campaign rows. Until now campaigns were an implicit
// grouping reconstructed from Draft.campaignId / Name / Type. This
// table promotes Campaign to its own entity so future Squadpitch
// modules (Sites, Ads, Inbox) can attach to a campaign cleanly.
//
// In this phase Draft.campaignId remains a plain String — backfill
// populates a Campaign row for every existing distinct campaignId,
// and the FK is added in a follow-up migration once production
// backfill is verified.
enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHING
  PUBLISHED
  ARCHIVED
  FAILED
}

model Campaign {
  // Prisma's @default(cuid()) generates ids for new rows; the
  // backfill script overrides this by passing an explicit `id`
  // equal to the existing Draft.campaignId string (e.g.
  // "camp_1759939200000_a3b9z2"), so legacy and new ids coexist.
  // The column itself is just TEXT and accepts either format.
  id               String         @id @default(cuid())
  clientId         String
  name             String
  campaignType     String // free-form, matches Draft.campaignType
  /**
   * Source attribution. Plans 02/04 persisted these into
   * Draft.warnings as key:value tags; promoting them to typed
   * columns lets Sites / Ads / Inbox read source attribution
   * without parsing warnings. Existing Draft.warnings writes are
   * preserved in this phase.
   */
  sourceType       String? // 'property' | 'data_item' | 'idea'
  sourceDataItemId String?
  sourceTitle      String?
  campaignIdea     String?        @db.Text
  status           CampaignStatus @default(DRAFT)
  startsAt         DateTime?
  endsAt           DateTime?
  metadataJson     Json?
  // Nullable so backfill never fails on a missing first-draft
  // createdBy. New campaigns set this to the acting user id.
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceDataItem WorkspaceDataItem? @relation("CampaignSourceDataItem", fields: [sourceDataItemId], references: [id], onDelete: SetNull)
  drafts         Draft[]
  sitePages      SitePage[]

  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([sourceDataItemId])
  @@map("campaigns")
}

// ── SquadSites ────────────────────────────────────────────────────────
//
// First-class models for the SquadSites public runtime
// (squadpitch-sites, served at [client].squadpitchsites.com).
// Phase B implementation: data model + read endpoints + form
// intake. Phase C adds the page builder UI in squadpitch-web.
//
// Constraint per the user: form submissions are stored only.
// No Conversation/Inbox models are created here — that's a
// separate later phase.

enum SiteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  PROCESSED
  SPAM
}

// Source-aware metadata for SitePage. When a page is generated
// from an existing workspace artifact (campaign, property listing,
// content asset, idea) we record that origin so future AI
// generation can re-use the source context, and the dashboard
// can show "from <campaign>" attribution. Nullable on the column
// because not every page has a single source — manually composed
// pages have no sourceType.
enum SiteSourceType {
  CAMPAIGN
  PROPERTY
  DATA_ITEM
  IDEA
}

// What the page is trying to accomplish. Drives default block
// composition + AI generation tone. Optional — manually composed
// pages can leave it null.
enum SitePageGoal {
  LEAD_CAPTURE
  LISTING
  OFFER
  EVENT
  CONSULTATION
}

model Site {
  // MVP: one Site per workspace (enforced by the unique
  // constraint on clientId). Multi-site comes in a later phase.
  id               String     @id @default(cuid())
  clientId         String     @unique
  status           SiteStatus @default(DRAFT)
  themeJson        Json?
  faviconUrl       String?
  ogDefaultImageId String?
  createdBy        String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages  SitePage[]
  forms  LeadForm[]

  @@index([clientId, status])
  @@map("sites")
}

model SitePage {
  id             String          @id @default(cuid())
  siteId         String
  clientId       String // denormalized for fast public lookup
  slug           String // URL path segment
  campaignId     String?
  // Source-aware metadata. campaignId stays for the FK relation;
  // sourceType + sourceId generalize to non-campaign origins so
  // a page generated from a property/data_item/idea can still
  // record its lineage. When sourceType=CAMPAIGN we also set
  // sourceId=campaignId so a single index covers all cases.
  sourceType     SiteSourceType?
  sourceId       String?
  pageGoal       SitePageGoal?
  // SEO directive — honored by the public runtime to emit
  // <meta name="robots" content="noindex,nofollow"> without
  // blocking the page render. Useful for unlisted /
  // share-by-link-only pages.
  noIndex        Boolean         @default(false)
  title          String
  description    String?
  status         PageStatus      @default(DRAFT)
  blocksJson     Json // [{ type, ...config }]
  heroImageId    String?
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  revalidateSec  Int             @default(60) // per-page ISR window
  publishedAt    DateTime?
  createdBy      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([clientId, slug])
  @@index([clientId, status])
  @@index([campaignId])
  @@index([sourceType, sourceId])
  @@map("site_pages")
}

model LeadForm {
  id            String   @id @default(cuid())
  siteId        String
  clientId      String // denormalized
  name          String
  fieldsJson    Json // [{ key, label, type, required, options? }]
  successAction Json // { type: 'message' | 'redirect', message?, url? }
  notifyEmail   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([clientId])
  @@map("lead_forms")
}

model FormSubmission {
  id           String           @id @default(cuid())
  formId       String
  clientId     String // denormalized for query speed + retention
  campaignId   String?
  pageId       String?
  dataJson     Json
  // Extracted from dataJson for query speed + future Inbox
  // contact lookup. Best-effort — may be null if the form has
  // no email/phone field.
  contactEmail String?
  contactPhone String?
  // SHA-256(ip + RUNTIME_IP_SALT). Never store the raw IP.
  ipHash       String?
  userAgent    String? // truncated to 500 chars at write time
  referer      String?
  status       SubmissionStatus @default(NEW)
  createdAt    DateTime         @default(now())

  form LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([formId, createdAt])
  @@index([campaignId])
  @@map("form_submissions")
}

// ── SquadInbox ─────────────────────────────────────────────────────────
//
// Lead/contact management on top of SquadSites form submissions.
// FormSubmission rows are immutable raw event data; Inbox layers a
// derived Contact + Conversation + Message graph that the dashboard
// works with. The intake service is idempotent on
// Conversation.sourceFormSubmissionId so retrying the worker (or
// running the backfill) on an already-processed submission is a no-op.

enum ContactSource {
  FORM
  IMPORT
  MANUAL
  // Social/email reserved for later phases; not used yet.
  SOCIAL
  EMAIL_REPLY
}

enum ContactStatus {
  NEW
  ENGAGED
  QUALIFIED
  CONVERTED
  ARCHIVED
}

enum ConversationSource {
  FORM
  SOCIAL
  EMAIL_REPLY
  MANUAL
  // Public review surface (Google Business Profile reviews today,
  // Facebook Page Recommendations / Yelp / etc. later). Distinct
  // from SOCIAL so the UI can render a "Google review" / "Public
  // response" framing rather than a generic comment chip.
  REVIEW
  // Public-comment surface (YouTube today; LinkedIn org pending
  // Community Management API approval). Distinct from SOCIAL_DM so
  // the AI prompt branches into the safer public-comment voice and
  // the UI labels the row as a comment rather than a DM.
  SOCIAL_COMMENT
}

// Per-network provider for a Conversation. Coarser sourceType
// (FORM/SOCIAL/...) stays as the high-level bucket; provider is
// the specific origin so the reply-action resolver can decide
// what's actually possible (SEND_EMAIL vs REPLY_DM vs review-reply).
// SQUADSITES covers the standard public-form intake path.
enum ConversationProvider {
  SQUADSITES
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS
  YOUTUBE
  LINKEDIN
  X
  TIKTOK
  THREADS
  PINTEREST
  WEB_CHAT
  MANUAL
}

// Privacy framing for an individual Message. Drives the UI's
// channel-aware composer rendering AND filters what is safe to
// include in AI prompts.
//   PUBLIC   — visible to anyone who can see the source (e.g. a
//              social comment reply that lives on the platform).
//   PRIVATE  — between the workspace and the lead only (email,
//              SMS, DM, form submission).
//   INTERNAL — workspace-only; never shown to the lead. Audit
//              SYSTEM messages and any future "private team note"
//              flavored messages.
enum MessageVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  SNOOZED
}

enum ConversationParty {
  CONTACT
  WORKSPACE
  SYSTEM
}

enum MessageChannel {
  FORM_SUBMISSION
  EMAIL
  SMS
  SOCIAL_DM
  MANUAL_LOG
}

// Delivery lifecycle for outbound Messages we actually try to send
// via a provider (Postmark, Twilio, Meta, etc). Nullable on the
// column because existing FORM_SUBMISSION / MANUAL_LOG rows have
// no real "delivery" — they were just recorded on the thread.
//   DRAFT     — composed but not yet attempted (reserved for future
//               "save draft" UX; current send path skips it).
//   SENDING   — provider call in flight; written BEFORE the call so
//               an in-flight crash leaves an auditable row.
//   SENT      — provider accepted the message; providerMessageId set.
//   FAILED    — provider rejected or call raised; errorReason set.
enum MessageDeliveryStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Contact {
  id       String @id @default(cuid())
  clientId String

  // Identity. At least one of email/phone must be non-null —
  // enforced at the service layer, not Prisma (which would require
  // a check constraint that doesn't round-trip cleanly).
  email String?
  phone String?
  name  String?

  firstSeenVia        ContactSource @default(FORM)
  firstSeenFormId     String?
  firstSeenPageId     String?
  firstSeenCampaignId String?

  // Append-only metadata captured at first sight + any subsequent
  // form fields. Service merges new entries; never overwrites.
  enrichmentJson Json?

  // Workspace-managed labels. Distinct from per-conversation tags
  // (deferred). Plain Postgres text[] for MVP.
  tags   String[]
  status ContactStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  // Per-workspace uniqueness — same email in two workspaces is
  // two distinct Contacts (multi-tenancy).
  @@unique([clientId, email])
  @@unique([clientId, phone])
  @@index([clientId, status, updatedAt])
  @@map("contacts")
}

model Conversation {
  id        String @id @default(cuid())
  clientId  String
  contactId String

  sourceType             ConversationSource @default(FORM)
  // 1:1 with the originating FormSubmission — unique constraint
  // is the idempotency key for the intake service. Re-running
  // intake on an already-converted submission is a safe no-op.
  sourceFormSubmissionId String?            @unique
  pageId                 String?
  campaignId             String?

  // Per-network provider — finer-grained than sourceType. Drives
  // the reply-action resolver (getAvailableReplyActions). Defaults
  // to SQUADSITES so existing FormSubmission conversations match
  // current production behavior after the backfill migration.
  provider ConversationProvider @default(SQUADSITES)

  // External thread/conversation id on the source provider. For
  // social DMs this is the platform's conversation id; for email
  // it's null because the RFC In-Reply-To chain lives on Message
  // rows. Nullable — only set when the provider gives us one.
  externalThreadId String?

  status ConversationStatus @default(OPEN)
  spam   Boolean            @default(false)

  // Inbox sort + unread badging. workspaceReadAt < lastMessageAt
  // && lastMessageFrom == CONTACT == unread.
  lastMessageAt   DateTime
  lastMessageFrom ConversationParty
  workspaceReadAt DateTime?

  // Assignee (future multi-user — currently solo workspaces leave
  // this null). String, not FK, so it can hold either User.id or
  // an Auth0 sub depending on the caller's convention.
  assignedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages  Message[]
  notes     ConversationNote[]
  aiReplies AIReplySuggestion[]

  @@index([clientId, status, lastMessageAt])
  @@index([clientId, provider, lastMessageAt])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("conversations")
}

model Message {
  id             String @id @default(cuid())
  conversationId String

  // CONTACT  — inbound from the lead
  // WORKSPACE — outbound from the agent (manual log for MVP)
  // SYSTEM   — automated event note ("Conversation opened", etc.)
  party   ConversationParty
  channel MessageChannel?

  body String @db.Text

  // Original structured payload. For FORM_SUBMISSION messages this
  // is the form's dataJson (label→value pairs) so the UI can render
  // a key/value strip alongside the body.
  payloadJson Json?

  // External provider id for outbound channels (Postmark, Twilio).
  // Set after a successful provider call.
  externalMessageId String?

  // Delivery lifecycle for real outbound sends (Inbox email reply
  // via Postmark today; SMS/social later). NULL for legacy
  // FORM_SUBMISSION + MANUAL_LOG rows that don't represent a
  // real provider call.
  deliveryStatus    MessageDeliveryStatus?
  // Provider's own message id (Postmark MessageID, Twilio SID, etc.)
  // — separate from externalMessageId because that field is also
  // used for inbound threading (the contact's email Message-ID
  // when we ingest a reply).
  providerMessageId String?
  // Last error reason when deliveryStatus = FAILED. Free-form so
  // we can keep provider language verbatim.
  errorReason       String?                @db.Text
  // When the most recent send attempt was made. Used to enforce
  // idempotency / rate limits at the audit layer.
  lastAttemptedAt   DateTime?

  // The user who composed an outbound/system message. Null for
  // inbound CONTACT messages.
  authorUserId String?

  // Provenance: which AI suggestion was accepted, if any.
  fromSuggestionId String?

  // Idempotency key for outbound sends. The web composer generates
  // a fresh UUID per Send click; a retried request (double-click,
  // network retry, server-restart-during-call) with the same key
  // returns the existing Message rather than firing a second
  // provider call. Nullable for legacy rows; uniqueness is per
  // conversation so different conversations can coincidentally
  // reuse a key (UUIDs make that effectively impossible anyway).
  idempotencyKey String?

  // Privacy framing. PRIVATE for direct channels (email, SMS, form
  // submissions, DMs); PUBLIC for surfaces that live on the
  // provider (e.g. a comment-reply on a social post); INTERNAL for
  // workspace-only audit/system rows. Defaulted to PRIVATE so
  // existing rows backfill safely.
  visibility MessageVisibility @default(PRIVATE)

  // Public-surface link, when applicable. For a social comment
  // this is the post URL on the platform; for an email it's null
  // (the email itself isn't web-addressable). Used by the UI to
  // offer "Open on Facebook" / "Open on YouTube" actions next to
  // the message body when present.
  sourceUrl String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
  @@map("messages")
}

model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

model AIReplySuggestion {
  id             String @id @default(cuid())
  conversationId String

  // The message this suggestion was generated to respond to.
  // If the contact replies again the dashboard can mark older
  // suggestions stale.
  forMessageId String

  body             String  @db.Text
  tone             String?
  model            String
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)

  // When the workspace user clicked "use this" — the resulting
  // outbound Message stamps fromSuggestionId, and we mark this
  // row acceptedAt. Used for "how often is the AI useful"
  // analytics later.
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_reply_suggestions")
}

// ── SquadAds ───────────────────────────────────────────────────────────
//
// MVP is export-only: AdPackage is the workspace artifact users
// generate, save, and download. We never call Meta Marketing API,
// Google Ads API, or any other ad-platform API — every "publish"
// affordance is replaced with "Export." The names are deliberately
// "AdPackage" (not "AdCampaign") to keep them distinct from the
// first-class Campaign model that already exists for the content
// pipeline.

enum AdObjective {
  AWARENESS
  TRAFFIC
  LEADS
  ENGAGEMENT
  EVENT
}

enum AdPackageStatus {
  DRAFT
  READY
  EXPORTED
  ARCHIVED
}

// Meta's Special Ad Categories — restrict targeting on age, gender,
// ZIP, and detailed targeting. We auto-tag HOUSING for real-estate
// workspaces and PROPERTY-sourced packages; users can manually
// pick the others if their content requires it.
enum AdSpecialCategory {
  NONE
  HOUSING
  EMPLOYMENT
  CREDIT
  SOCIAL_ISSUES
}

enum AdDestinationKind {
  SITE_PAGE
  EXTERNAL_URL
  SOCIAL_PROFILE
}

// What kind of workspace artifact seeded the package. Mirrors the
// SiteSourceType pattern so source-context loaders can be shared.
enum AdSourceType {
  CAMPAIGN
  SITE_PAGE
  DRAFT
  PROPERTY
  CONTENT_ASSET
  IDEA
}

model AdPackage {
  id              String            @id @default(cuid())
  clientId        String
  name            String
  objective       AdObjective
  status          AdPackageStatus   @default(DRAFT)
  specialCategory AdSpecialCategory @default(NONE)

  // Source attribution — mirrors SitePage.sourceType/sourceId.
  // sourceId nullable for IDEA (free-form text only).
  sourceType AdSourceType
  sourceId   String?
  sourceIdea String?      @db.Text

  // Generation provenance — same bookkeeping shape as
  // AIReplySuggestion so future spend analytics is consistent.
  generatedByModel String?
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)

  // Append-only export history.
  // [{ format, url, generatedAt, generatedBy }]
  exportsJson Json @default("[]")

  // Mandatory user review trail before status can flip to READY.
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?   @db.Text

  // Free-form workspace metadata (used today for the
  // requiresBudgetReview flag the export gate consults).
  metadataJson Json?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creatives   AdCreative[]
  audience    AdAudience?
  budget      AdBudget?
  destination AdDestination?

  @@index([clientId, status, updatedAt])
  @@index([clientId, sourceType, sourceId])
  @@map("ad_packages")
}

model AdCreative {
  id           String @id @default(cuid())
  adPackageId  String
  // 1..N A/B variants. The unique constraint on (adPackageId,
  // variantIndex) keeps the export bundle ordering stable.
  variantIndex Int

  // Optional channel hint so the export PDF can label "Recommended
  // for Instagram Reels" etc. Reuses the existing organic Channel
  // enum; ad publishing is deferred so no new channel values needed.
  channel Channel?

  headline    String  @db.Text
  primaryText String  @db.Text
  description String? @db.Text
  cta         String? // "Learn More" | "Sign Up" | "Get Quote" | etc.

  // MediaAsset reuse — no new image storage.
  primaryAssetId String?
  primaryAsset   MediaAsset? @relation("AdCreativePrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: SetNull)

  // Carousel / additional creative — array of MediaAsset ids.
  // Not FK-enforced because Prisma can't model a relation list off
  // a JSON column; service layer is responsible for asset lookups.
  additionalAssetIdsJson Json @default("[]")

  // AI-generated rationale shown in the UI and included in the
  // export so the paid-media team understands the angle.
  rationale String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adPackage AdPackage @relation(fields: [adPackageId], references: [id], onDelete: Cascade)

  @@unique([adPackageId, variantIndex])
  @@index([adPackageId])
  @@map("ad_creatives")
}

model AdAudience {
  id          String @id @default(cuid())
  adPackageId String @unique // 1:1

  // [{ kind: 'country' | 'region' | 'city' | 'postal', value: '...' }]
  locationsJson Json @default("[]")

  // Demographics — forcibly cleared at service layer when
  // specialCategory != NONE per Fair Housing / Meta SAC rules.
  ageMin      Int?
  ageMax      Int?
  gendersJson Json @default("[\"all\"]")

  interestsJson           Json @default("[]")
  // [{ kind: 'lookalike' | 'retargeting' | 'engaged_recent', description }]
  customAudienceHintsJson Json @default("[]")
  // ISO codes: ['en', 'es']
  languagesJson           Json @default("[]")

  // Denormalized so the export bundle's compliance disclaimer can
  // be generated without re-resolving the workspace's industry.
  housingRestricted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adPackage AdPackage @relation(fields: [adPackageId], references: [id], onDelete: Cascade)

  @@map("ad_audiences")
}

model AdBudget {
  id          String @id @default(cuid())
  adPackageId String @unique // 1:1

  // Cents — matches billing-table convention to avoid float drift.
  // Service enforces "exactly one of dailyBudgetCents / totalBudgetCents".
  dailyBudgetCents Int?
  totalBudgetCents Int?
  currency         String @default("USD")
  durationDays     Int?

  startsAt DateTime?
  endsAt   DateTime?

  // What the AI suggested vs. what the user kept — diff lets us
  // measure suggestion acceptance later.
  suggestedDailyBudgetCents Int?
  suggestedTotalBudgetCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adPackage AdPackage @relation(fields: [adPackageId], references: [id], onDelete: Cascade)

  @@map("ad_budgets")
}

model AdDestination {
  id          String @id @default(cuid())
  adPackageId String @unique // 1:1

  kind AdDestinationKind

  // Discriminated union — exactly one is non-null based on kind.
  // Service enforces; DB allows nulls to keep the schema simple.
  sitePageId    String?
  externalUrl   String?
  socialProfile String? // e.g. "instagram:smithrealty"

  // UTM params appended to the destination URL on export.
  // { source, medium, campaign, content, term }
  utmJson Json?

  // Pixel/conversion ids the user pasted in — preserved in the
  // export bundle's README so the paid-media team can re-apply
  // them in the ad platform.
  pixelIdsJson Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adPackage AdPackage @relation(fields: [adPackageId], references: [id], onDelete: Cascade)

  @@map("ad_destinations")
}

model MediaProfile {
  clientId           String    @id
  mode               MediaMode @default(BRAND_ASSETS_ONLY)
  visualStyle        String?   @db.Text
  assetLibraryJson   Json?
  characterPrompt    String?   @db.Text
  basePromptTemplate String?   @db.Text
  loraModelUrl       String?
  loraTriggerWord    String?
  loraScale          Float?    @default(1.0)
  updatedBy          String?
  updatedAt          DateTime  @updatedAt
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("media_profiles")
}

// ── Brand Persona ─────────────────────────────────────────────────────

model BrandPersona {
  clientId         String                @id
  userId           String?
  personaType      PersonaType           @default(AGENT)
  name             String?
  status           PersonaTrainingStatus @default(DRAFT)
  trainingImages   Json                  @default("[]")
  imageCount       Int                   @default(0)
  visualStyle      String?
  usageSettings    Json                  @default("{}")
  trainingProgress Int?                  @default(0)
  previewImages    Json?
  styleProfile     Json? // Brand Style Profile (colors, fonts, prompt modifiers)

  // Provider integration (fal.ai LoRA training)
  provider           String? @default("fal")
  providerTrainingId String?
  providerModelId    String?
  triggerPhrase      String?
  errorMessage       String? @db.Text

  // Consent
  consentAt DateTime?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("brand_personas")
}

// ── Channel Settings ───────────────────────────────────────────────────

model ChannelSettings {
  id               String   @id @default(cuid())
  clientId         String
  channel          Channel
  isEnabled        Boolean  @default(true)
  maxChars         Int?
  allowEmoji       Boolean  @default(true)
  trailingHashtags String[]
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, channel])
  @@map("channel_settings")
}

// ── Draft ──────────────────────────────────────────────────────────────

model Draft {
  id        String      @id @default(cuid())
  clientId  String
  kind      DraftKind
  status    DraftStatus @default(DRAFT)
  channel   Channel
  bucketKey String?

  generationGuidance String  @db.Text
  modelUsed          String?
  promptVersion      Int     @default(1)

  body          String   @db.Text
  hooks         String[]
  hashtags      String[]
  cta           String?
  variations    Json?
  scoredHooks   Json?
  altText       String?  @db.Text
  imageGuidance String?  @db.Text
  videoGuidance String?  @db.Text
  mediaPlan     Json?
  warnings      String[]

  // Campaign fields — nullable for non-campaign drafts
  campaignId    String?
  campaignName  String?
  campaignType  String?
  campaignDay   Int?
  campaignOrder Int?
  campaignTotal Int?

  mediaUrl             String?
  mediaType            String?
  externalPostId       String?
  externalPostUrl      String?
  publishError         String?   @db.Text
  publishAttempts      Int       @default(0)
  lastPublishAttemptAt DateTime?
  idempotencyKey       String?   @unique
  publishSource        String?

  performanceRating String?
  ratedAt           DateTime?

  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  scheduledFor   DateTime?
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Draft.campaignId became a real FK in Phase 4 of the Campaign
  // model promotion. The historical `camp_<ts>_<rand>` strings and
  // the new cuid-based ids both live in this column — Campaign.id
  // is TEXT and accepts either. SetNull preserves publishing
  // history if a campaign is later archived/deleted.
  campaign         Campaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  moderationLogs   ModerationLog[]
  mediaAssets      MediaAsset[]
  draftAssets      DraftAsset[]
  metrics          PostMetrics?
  metricSnapshots  PostMetricSnapshot[]
  rawMetric        RawMetric[]
  normalizedMetric NormalizedMetric?
  postInsight      PostInsight?
  contentSources   GeneratedContentSource[]
  trackableLinks   TrackableLink[]
  conversionEvents ConversionEvent[]

  @@index([clientId, status])
  @@index([clientId, channel])
  @@index([status, scheduledFor])
  @@index([clientId, campaignId])
  @@map("drafts")
}

// ── Channel Connection ─────────────────────────────────────────────────

model ChannelConnection {
  id                String           @id @default(cuid())
  clientId          String
  channel           Channel
  externalAccountId String?
  displayName       String?
  accessToken       String           @db.Text
  refreshToken      String?          @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            ConnectionStatus @default(CONNECTED)
  lastValidatedAt   DateTime?
  lastError         String?          @db.Text
  lastRefreshAt     DateTime?
  refreshFailedAt   DateTime?
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, channel])
  @@index([channel, status])
  @@map("channel_connections")
}

// ── Moderation Log ─────────────────────────────────────────────────────

model ModerationLog {
  id         String      @id @default(cuid())
  draftId    String
  clientId   String
  fromStatus DraftStatus
  toStatus   DraftStatus
  actorSub   String
  reason     String?
  createdAt  DateTime    @default(now())
  draft      Draft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("moderation_logs")
}

// ── Media Asset ────────────────────────────────────────────────────────

model MediaAsset {
  id            String           @id @default(cuid())
  clientId      String
  source        MediaAssetSource
  status        MediaAssetStatus @default(READY)
  progressStage String?

  url              String?
  publicId         String?
  width            Int?
  height           Int?
  bytes            Int?
  mimeType         String?
  assetType        String  @default("image")
  thumbnailUrl     String?
  videoDurationSec Int?

  filename String?
  altText  String? @db.Text
  caption  String?

  folderId String?
  folder   AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags     String[]     @default([])

  draftId      String?
  draft        Draft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)
  displayOrder Int     @default(0)

  falModelId        String?
  renderedPrompt    String? @db.Text
  negativePrompt    String? @db.Text
  loraSnapshot      String?
  loraScaleSnapshot Float?
  personaSnapshot   String? // Name of persona used (if any)
  seed              BigInt?

  // Screenshot-import enhancement metadata (spinstr97)
  isEnhanced    Boolean @default(false)
  qualityScore  Float?
  qualityLabel  String? // "good" | "fair" | "low"
  externalJobId String?
  durationMs    Int?
  errorMessage  String? @db.Text

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draftAssets          DraftAsset[]
  // Back-relation for AdCreative.primaryAsset. The relation is
  // named because future fields may also reference MediaAsset and
  // we want each FK clearly attributed.
  adCreativesAsPrimary AdCreative[] @relation("AdCreativePrimaryAsset")

  @@index([clientId, status])
  @@index([clientId, source])
  @@index([clientId, folderId])
  @@index([draftId])
  @@map("media_assets")
}

// ── Asset Folders ─────────────────────────────────────────────────────

model AssetFolder {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets MediaAsset[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("asset_folders")
}

// ── Draft-Asset Join Table ────────────────────────────────────────────

model DraftAsset {
  id         String   @id @default(cuid())
  draftId    String
  assetId    String
  role       String? // "primary", "thumbnail", or null
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  draft Draft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([draftId, assetId])
  @@index([assetId])
  @@map("draft_assets")
}

// ── Subscription ──────────────────────────────────────────────────────

enum PlanTier {
  STARTER
  GROWTH
  PRO
  AGENCY
}

enum AiActionType {
  GENERATE_POST
  REGENERATE
  PARSE
  IMAGE
  VIDEO
  IDEAS
  ONBOARDING
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  stripeCustomerId       String             @unique
  stripeSubscriptionId   String?            @unique
  tier                   PlanTier           @default(STARTER)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  // Stripe webhook ordering guard. Older events (delayed retries, network
  // re-orderings) must not overwrite newer subscription state.
  // `lastStripeEventCreated` is the unix-second timestamp of the most
  // recent processed event for this subscription; stale events are
  // ignored. `lastStripeEventId` lets us detect duplicates of the same
  // event id and skip cleanly.
  lastStripeEventCreated Int?
  lastStripeEventId      String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("subscriptions")
}

model UsageRecord {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  posts            Int      @default(0)
  images           Int      @default(0)
  videos           Int      @default(0)
  imageGenerations Int      @default(0)
  videoGenerations Int      @default(0)
  enhancementRuns  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, periodStart])
  @@map("usage_records")
}

model AiUsageLog {
  id                 String       @id @default(cuid())
  userId             String
  clientId           String?
  actionType         AiActionType
  model              String
  promptTokens       Int          @default(0)
  completionTokens   Int          @default(0)
  estimatedCostCents Float        @default(0)
  metadata           Json?
  createdAt          DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@map("ai_usage_logs")
}

// ── Post Metrics ───────────────────────────────────────────────────────

model PostMetrics {
  id       String  @id @default(cuid())
  draftId  String  @unique
  clientId String
  channel  Channel

  impressions    Int    @default(0)
  reach          Int    @default(0)
  engagement     Int    @default(0)
  clicks         Int    @default(0)
  saves          Int    @default(0)
  shares         Int    @default(0)
  comments       Int    @default(0)
  likes          Int    @default(0)
  engagementRate Float?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, channel])
  @@index([clientId, lastSyncedAt])
  @@map("post_metrics")
}

model PostMetricSnapshot {
  id         String   @id @default(cuid())
  draftId    String
  clientId   String
  channel    Channel
  snapshotAt DateTime

  impressions    Int    @default(0)
  reach          Int    @default(0)
  engagements    Int    @default(0)
  clicks         Int    @default(0)
  saves          Int    @default(0)
  shares         Int    @default(0)
  comments       Int    @default(0)
  likes          Int    @default(0)
  engagementRate Float?

  createdAt DateTime @default(now())

  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([draftId, snapshotAt])
  @@index([draftId, snapshotAt])
  @@index([clientId])
  @@map("post_metric_snapshots")
}

// ── Notifications ────────────────────────────────────────────────────

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  pushEnabled     Boolean  @default(false)
  digestEnabled   Boolean  @default(true)
  phoneNumber     String?
  preferencesJson Json     @default("{\"POST_PUBLISHED\":true,\"POST_FAILED\":true,\"USAGE_LIMIT_NEARING\":true,\"CONNECTION_EXPIRED\":true,\"BATCH_COMPLETE\":true}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationLog {
  id                String   @id @default(cuid())
  userId            String
  eventType         String
  channel           String // "email" | "sms"
  status            String   @default("queued") // queued | sent | failed | skipped
  provider          String? // "postmark" | "twilio"
  providerMessageId String?
  resourceType      String? // "draft" | "connection" | "usage" etc.
  resourceId        String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, eventType])
  @@index([userId, eventType, resourceId])
  @@map("notification_logs")
}

// ── In-App Notifications ────────────────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  userId       String
  eventType    String
  title        String
  message      String   @db.Text
  linkUrl      String?
  resourceType String?
  resourceId   String?
  read         Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityEvent {
  id           String   @id @default(cuid())
  userId       String
  clientId     String?
  eventType    String
  title        String
  description  String?  @db.Text
  icon         String?
  linkUrl      String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, clientId, createdAt])
  @@map("activity_events")
}

// ── Slack Integration ─────────────────────────────────────────────────

model SlackConnection {
  id               String   @id @default(cuid())
  userId           String   @unique
  webhookUrl       String   @db.Text
  channelName      String?
  isActive         Boolean  @default(true)
  subscribedEvents Json     @default("[\"POST_FAILED\",\"POST_PUBLISHED\",\"BATCH_COMPLETE\",\"CONNECTION_EXPIRED\"]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("slack_connections")
}

// ── Outbound Webhooks ─────────────────────────────────────────────────

model OutboundWebhook {
  id               String   @id @default(cuid())
  userId           String
  targetUrl        String   @db.Text
  secret           String
  subscribedEvents Json     @default("[\"POST_PUBLISHED\",\"POST_FAILED\",\"BATCH_COMPLETE\",\"CONNECTION_EXPIRED\"]")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveryLogs WebhookDeliveryLog[]

  @@index([userId])
  @@map("outbound_webhooks")
}

model WebhookDeliveryLog {
  id             String    @id @default(cuid())
  webhookId      String
  eventType      String
  requestBody    Json
  requestHeaders Json?
  responseStatus Int?
  responseBody   String?   @db.Text
  status         String    @default("pending") // pending | success | failed
  attemptCount   Int       @default(0)
  deliveredAt    DateTime?
  replayOfId     String?
  createdAt      DateTime  @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([replayOfId])
  @@map("webhook_delivery_logs")
}

// ── Generic Integrations ────────────────────────────────────────────

model Integration {
  id        String   @id @default(cuid())
  userId    String
  type      String // "slack" | "webhook" | "notion" | "google_sheets"
  name      String
  config    Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs IntegrationLog[]

  @@index([userId, type])
  @@map("integrations")
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  eventType     String
  status        String   @default("pending") // "pending" | "success" | "failed"
  responseData  Json?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@map("integration_logs")
}

// ── Analytics ─────────────────────────────────────────────────────────

model RawMetric {
  id             String   @id @default(cuid())
  clientId       String
  draftId        String
  channel        Channel
  externalPostId String?
  rawDataJson    Json
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([draftId])
  @@map("raw_metrics")
}

model NormalizedMetric {
  id                     String   @id @default(cuid())
  clientId               String
  draftId                String   @unique
  channel                Channel
  impressions            Int?
  reach                  Int?
  engagements            Int?
  clicks                 Int?
  engagementRate         Float?
  relativeEngagementRate Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([clientId, channel])
  @@map("normalized_metrics")
}

model PostInsight {
  id                 String   @id @default(cuid())
  clientId           String
  draftId            String   @unique
  qualityScore       Float?
  observedScore      Float?
  compositeScore     Float?
  contentType        String?
  hookType           String?
  sentiment          String?
  lengthBucket       String?
  mediaType          String?
  postingTimeBucket  String?
  recommendationTags Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("post_insights")
}

// ── Workspace Analytics ──────────────────────────────────────────────

model WorkspaceAnalytics {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  avgEngagementRate   Float?
  avgQualityScore     Float?
  avgObservedScore    Float?
  avgCompositeScore   Float?
  totalPosts          Int      @default(0)
  totalPublishedPosts Int      @default(0)
  totalReach          Int      @default(0)
  totalEngagements    Int      @default(0)
  topPlatform         String?
  bestContentType     String?
  bestMediaType       String?
  lastCalculatedAt    DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("workspace_analytics")
}

model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  clientId          String
  snapshotDate      DateTime @db.Date
  avgQualityScore   Float?
  avgObservedScore  Float?
  avgCompositeScore Float?
  avgEngagementRate Float?
  totalPosts        Int      @default(0)
  totalReach        Int      @default(0)
  totalEngagements  Int      @default(0)
  createdAt         DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, snapshotDate])
  @@index([clientId, snapshotDate])
  @@map("analytics_snapshots")
}

// ── Business Data ────────────────────────────────────────────────────

model WorkspaceDataSource {
  id        String         @id @default(cuid())
  clientId  String
  type      DataSourceType @default(MANUAL)
  name      String
  config    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dataItems WorkspaceDataItem[]

  @@index([clientId])
  @@map("workspace_data_sources")
}

model WorkspaceDataItem {
  id           String         @id @default(cuid())
  clientId     String
  dataSourceId String
  type         DataItemType
  status       DataItemStatus @default(ACTIVE)
  title        String
  summary      String?        @db.Text
  dataJson     Json
  tags         String[]
  priority     Int            @default(0)
  expiresAt    DateTime?
  usageCount   Int            @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dataSource     WorkspaceDataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  contentSources GeneratedContentSource[]
  performance    DataItemPerformance?
  campaigns      Campaign[]               @relation("CampaignSourceDataItem")

  @@index([clientId, status])
  @@index([clientId, type])
  @@map("workspace_data_items")
}

model ContentBlueprint {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  description        String            @db.Text
  category           BlueprintCategory
  promptTemplate     String            @db.Text
  applicableTypes    DataItemType[]
  applicableChannels Channel[]
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  contentSources GeneratedContentSource[]
  performance    BlueprintPerformance?

  @@index([category])
  @@map("content_blueprints")
}

model GeneratedContentSource {
  id          String   @id @default(cuid())
  draftId     String
  dataItemId  String
  blueprintId String
  createdAt   DateTime @default(now())

  draft     Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  dataItem  WorkspaceDataItem @relation(fields: [dataItemId], references: [id], onDelete: Cascade)
  blueprint ContentBlueprint  @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([dataItemId])
  @@index([blueprintId])
  @@map("generated_content_sources")
}

model DataItemPerformance {
  id                String   @id @default(cuid())
  dataItemId        String   @unique
  totalDrafts       Int      @default(0)
  totalPublished    Int      @default(0)
  avgEngagement     Float?
  avgQualityScore   Float?
  avgObservedScore  Float?
  avgCompositeScore Float?
  lastCalculated    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dataItem WorkspaceDataItem @relation(fields: [dataItemId], references: [id], onDelete: Cascade)

  @@map("data_item_performance")
}

model BlueprintPerformance {
  id                String   @id @default(cuid())
  blueprintId       String   @unique
  totalDrafts       Int      @default(0)
  totalPublished    Int      @default(0)
  avgEngagement     Float?
  avgQualityScore   Float?
  avgObservedScore  Float?
  avgCompositeScore Float?
  lastCalculated    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  blueprint ContentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_performance")
}

// ── Tech Stack Connections ────────────────────────────────────────────

model WorkspaceTechStackConnection {
  id               String    @id @default(cuid())
  workspaceId      String
  providerKey      String
  connectionStatus String    @default("not_connected")
  metadataJson     Json?
  lastError        String?
  connectedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Client @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
  @@map("workspace_tech_stack_connections")
}

// ── Conversion Analytics ────────────────────────────────────────────

model TrackableLink {
  id             String   @id @default(cuid())
  clientId       String
  draftId        String?
  shortCode      String   @unique
  destinationUrl String   @db.Text
  label          String?
  channel        Channel?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  isActive       Boolean  @default(true)
  clickCount     Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft  Draft?            @relation(fields: [draftId], references: [id], onDelete: SetNull)
  events ConversionEvent[]

  @@index([clientId])
  @@index([draftId])
  @@map("trackable_links")
}

model ConversionEvent {
  id              String              @id @default(cuid())
  clientId        String
  draftId         String?
  trackableLinkId String?
  type            ConversionEventType
  label           String?
  referrerUrl     String?             @db.Text
  userAgentHash   String?
  ipHash          String?
  country         String?
  metadata        Json?
  createdAt       DateTime            @default(now())

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft         Draft?         @relation(fields: [draftId], references: [id], onDelete: SetNull)
  trackableLink TrackableLink? @relation(fields: [trackableLinkId], references: [id], onDelete: SetNull)

  @@index([clientId, type])
  @@index([clientId, createdAt])
  @@index([draftId])
  @@index([trackableLinkId])
  @@map("conversion_events")
}

// ── External Service Registry ─────────────────────────────────────────

model ExternalService {
  id             String  @id @default(cuid())
  key            String  @unique // e.g. "openai", "fal", "auth0", "stripe"
  name           String // Display name
  category       String // "ai", "infrastructure", "auth", "billing", "messaging", "data"
  purpose        String  @db.Text // What this service does for Squadpitch
  status         String  @default("healthy") // "healthy", "watch", "near_limit", "critical", "down"
  criticality    String  @default("standard") // "critical", "high", "standard", "low"
  environment    String  @default("production") // "production", "staging", "development"
  consoleUrl     String? @db.Text
  docsUrl        String? @db.Text
  notes          String? @db.Text
  usedByFeatures String? @db.Text // Comma-separated feature list
  recoveryNotes  String? @db.Text
  fallbackInfo   String? @db.Text

  // Subscription / billing
  planName         String? // e.g. "Pro", "Team", "Pay-as-you-go"
  billingCycle     String? // "monthly", "annual", "usage"
  renewalDate      DateTime?
  monthlyCostCents Int?

  // Usage / quota
  hardLimit    Float? // Absolute max
  softLimit    Float? // Warning threshold
  currentUsage Float?
  usageUnit    String? // "requests", "tokens", "gb", "emails", "dollars"
  usageSource  String  @default("manual") // "manual", "api", "derived"
  percentUsed  Float? // Cached 0-100

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageSnapshots ExternalServiceUsageSnapshot[]

  @@index([category])
  @@index([status])
  @@map("external_services")
}

model ExternalServiceUsageSnapshot {
  id          String   @id @default(cuid())
  serviceId   String
  usage       Float
  limit       Float?
  percentUsed Float?
  note        String?
  source      String   @default("manual") // "manual", "api", "derived"
  snapshotAt  DateTime @default(now())

  service ExternalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, snapshotAt])
  @@map("external_service_usage_snapshots")
}

// ── Beta Operations ───────────────────────────────────────────────────

model BetaTester {
  id           String    @id @default(cuid())
  userId       String // auth0Sub or User.id
  email        String
  name         String?
  workspaceId  String? // Primary workspace for testing
  status       String    @default("active") // "active", "invited", "paused", "churned"
  cohort       String? // e.g. "alpha", "beta-1", "launch"
  tags         String[] // e.g. ["high-touch", "paid", "real-estate", "power-user"]
  priority     String    @default("normal") // "high", "normal", "low"
  joinedAt     DateTime  @default(now())
  notes        String?   @db.Text // Internal notes
  contactNotes String?   @db.Text // Follow-up / contact info
  featureFlags Json? // Snapshot of enabled features/betas
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  feedback BetaFeedback[]

  @@unique([userId])
  @@index([status])
  @@index([cohort])
  @@index([workspaceId])
  @@map("beta_testers")
}

model BetaFeedback {
  id                String    @id @default(cuid())
  testerId          String?
  userId            String // Submitter auth0Sub or User.id
  workspaceId       String?
  type              String    @default("general") // "bug", "feature_request", "ux_issue", "general", "praise", "question"
  severity          String    @default("medium") // "critical", "high", "medium", "low"
  title             String
  body              String    @db.Text
  route             String? // Page/route where feedback originated
  screenshotUrl     String?   @db.Text
  relatedEntityType String? // "draft", "campaign", "connection", "workspace"
  relatedEntityId   String?
  featureFlags      Json? // Snapshot at time of submission
  metadata          Json? // Browser info, app version, etc.
  status            String    @default("new") // "new", "triaged", "in_progress", "resolved", "wont_fix", "duplicate"
  assignee          String? // Admin handling this
  internalNotes     String?   @db.Text
  needsFollowUp     Boolean   @default(false)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tester BetaTester? @relation(fields: [testerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([testerId])
  @@index([userId])
  @@index([severity])
  @@index([needsFollowUp])
  @@map("beta_feedback")
}

// ── Feature Flags ───────────────────────────────────────────────────────

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique // e.g. "video_gen_beta", "new_onboarding_flow"
  name              String // Human-readable name
  description       String?  @db.Text
  category          String   @default("feature") // "feature", "rollout", "ops", "experiment"
  enabled           Boolean  @default(false)
  scope             String   @default("global") // "global", "targeted"
  targetType        String? // "workspace", "user", "cohort" — null if global
  targetIds         String[] // IDs of targeted workspaces, users, or cohort names
  rolloutPercentage Int? // 0–100 for gradual rollouts (null = binary on/off)
  notes             String?  @db.Text // Internal notes / change log
  createdBy         String? // admin who created
  updatedBy         String? // admin who last modified
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@index([enabled])
  @@map("feature_flags")
}

// ── Audit Log ───────────────────────────────────────────────────────────
//
// Append-only record of admin/developer mutations on the internal admin
// console. Read by ops + support to answer "who toggled this flag" /
// "why did the tester get deleted".
//
// Critical: nothing in `metadata` should be a secret. The audit-log
// service redacts known sensitive keys before write. Schema-level
// guarantees aren't possible here (Json column), so the discipline lives
// in lib/auditLog.js.

model AuditLog {
  id           String   @id @default(cuid())
  actorSub     String // Auth0 sub of the admin/developer who acted
  actorEmail   String? // Snapshot of email at action time (for reads after a user is renamed/deleted)
  actorRoles   String[] // Snapshot of roles at action time
  action       String // e.g. "flag.toggle", "service.delete", "tester.update"
  resourceType String // "FeatureFlag" | "ExternalService" | "BetaTester" | "BetaFeedback" | …
  resourceId   String? // ID of the touched record (null for bulk actions)
  route        String? // HTTP method + path, e.g. "PATCH /api/v1/internal/config/flags/abc"
  metadata     Json? // Action-specific context (before/after diff, reason, etc.) — secrets redacted
  ip           String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([actorSub, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
